# Salin file ini jadi .env.local dan isi nilainya.
# JANGAN PERNAH commit .env.local ke git — semua key/secret hanya dibaca di server.

# --- LahaStore: buat AI lain (Gemini dkk) ---
# Key kamu sudah aktif (tier Standard). Base URL sesuai docs.
LAHASTORE_BASE_URL=https://lahastore.up.railway.app/api/v1
LAHASTORE_API_KEY=isi_dengan_key_lahastore

# --- Sondev: buat Muse ---
# Key + secret dari bot Telegram Sondev: /reseller -> "Reveal Secret".
# Secret cuma ditampilin SEKALI — simpan di sini langsung begitu reveal.
SONDEV_BASE_URL=https://api.sondevs.tech/api/v1
SONDEV_API_KEY=isi_dengan_key_sondev
SONDEV_API_SECRET=isi_dengan_secret_sondev

# --- Database ---
# SQLite lokal (file dev.db) via node:sqlite — tanpa dependency tambahan.
# Produksi: ganti driver di src/lib/db.ts ke Postgres + sesuaikan URL ini.
DATABASE_URL="file:./dev.db"

# --- Telegram Bot (Unicodes Digital) ---
# Token dari @BotFather (/newbot). Admin IDs: ID Telegram kamu (cek via @userinfobot),
# pisahkan koma kalau lebih dari satu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# --- Pembayaran: Midtrans Snap (QRIS) — jalur bayar aktif sejak 2026-11-21 ---
# Daftar di https://midtrans.com -> Merchant Administration Portal (MAP):
# Settings -> Access Keys -> salin Server Key + Client Key (sandbox dulu,
# lalu production). MIDTRANS_IS_PRODUCTION=true HANYA setelah key production.
# Uang hasil penjualan bisa ditarik (withdraw) minimal 3 hari kerja setelah
# transaksi settlement — manual di menu SALDO, atau otomatis di
# Settings -> Withdrawal (min saldo Rp50.000).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Pembayaran QRIS GoPay (cadangan — tidak lagi dipakai sejak Midtrans) ---
# QRIS statis merchant disimpan di database lewat panel /admin (bukan env).
# Sesi login GoBiz (OTP) juga di panel /admin.
# Nomor HP GoBiz (dipakai sebagai default saat minta OTP di panel):
GOBIZ_PHONE=

# --- Interval polling feed GoBiz (ms, opsional, default 30000) ---
# GOPAY_POLL_INTERVAL_MS=30000

NEXT_PUBLIC_APP_URL=http://localhost:3000
